[Unit]
Description=Dayao personal novel server
After=network.target

[Service]
Type=simple
User=dayao
Group=dayao
WorkingDirectory=/opt/dayao
EnvironmentFile=/etc/dayao.env
ExecStart=/usr/bin/node /opt/dayao/scripts/serve.mjs start
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/dayao /opt/dayao/.next/cache
UMask=0077

[Install]
WantedBy=multi-user.target
